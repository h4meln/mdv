:root{color-scheme:dark;--bg:#10121b;--panel:#171a25;--line:#ffffff17;--text:#ecedf3;--muted:#a0abc2;--blue:#8ab4f5;--red:#ef7b8b}
*{box-sizing:border-box}body{margin:0;background:var(--bg);color:var(--text);font:13px/1.5 Manrope,sans-serif}button,input,textarea,select{font:inherit}button,a,input,textarea,select{-webkit-tap-highlight-color:transparent}button{cursor:pointer;color:inherit;border:1px solid var(--line);background:transparent;border-radius:7px;padding:9px 12px;min-height:40px}button:hover{background:#ffffff09;border-color:#8ab4f577}button:disabled{opacity:.32;cursor:default}button:focus-visible,a:focus-visible,input:focus-visible,textarea:focus-visible,select:focus-visible{outline:2px solid var(--blue);outline-offset:3px}a{color:var(--blue);text-underline-offset:4px}[hidden]{display:none!important}.topbar{min-height:108px;display:flex;align-items:center;gap:20px;padding:20px 30px;border-bottom:1px solid var(--line)}.brand img{display:block;width:44px;height:58px}.masthead span{font-size:10px;letter-spacing:.18em;color:var(--red)}h1{font:700 42px/1.1 'Amatic SC',cursive;margin:4px 0 0}.project-actions{margin-left:auto;display:flex;gap:8px}.primary{background:var(--blue);color:#111928;border:0;font-weight:700}.primary:hover{background:#b2cefc}.workbench{display:grid;grid-template-columns:240px minmax(320px,1fr) 320px;min-height:calc(100dvh - 108px)}.library,.inspector{padding:26px 20px;min-width:0}.library{border-right:1px solid var(--line);display:flex;flex-direction:column}.inspector{border-left:1px solid var(--line)}.section-heading{display:flex;align-items:center;justify-content:space-between;gap:8px;margin-bottom:20px}.section-heading h2{font:700 30px 'Amatic SC',cursive;margin:0}.section-heading>span{font-size:10px;letter-spacing:.08em;color:var(--muted)}.add{width:100%;border-color:#8ab4f544;color:var(--blue);margin-bottom:24px}.search-label{font-size:11px;color:var(--muted);margin-bottom:8px}input,select,textarea{width:100%;min-width:0;border:1px solid #ffffff1d;border-radius:6px;background:#ffffff04;padding:10px 11px;color:var(--text);min-height:42px}input::placeholder,textarea::placeholder{color:#8290aa}select option{background:var(--panel)}.event-list{margin:16px -8px;display:flex;flex-direction:column;gap:5px;max-height:60vh;overflow:auto}.event-entry{text-align:left;display:grid;grid-template-columns:32px 1fr;gap:10px;border-color:transparent;border-radius:4px;padding:12px 8px}.event-entry[aria-current=true]{background:#8ab4f50f;border-left:2px solid var(--blue)}.event-entry .date-tag{font-size:11px;line-height:1.5;color:var(--blue);white-space:pre-line;text-align:center}.event-entry strong{display:block;font-size:13px;overflow-wrap:anywhere}.event-entry small{display:block;color:var(--muted);margin-top:5px}.event-entry.invalid strong::after{content:' â€¢';color:var(--red)}.empty-list{font-size:12px;line-height:1.8;color:var(--muted);padding:12px 8px}.library-footer{margin-top:auto;padding-top:30px;color:var(--muted);font-size:11px}.library-footer>span{color:var(--blue)}.library-footer p{max-width:25ch;line-height:1.7}.preview-area{min-width:0;padding:26px 32px;display:flex;flex-direction:column}.preview-toolbar{display:flex;align-items:center;justify-content:space-between;gap:14px;margin-bottom:24px}.preview-toolbar>span{font-size:9px;letter-spacing:.15em;color:var(--muted)}.preview-tabs{display:flex;gap:4px}.preview-tabs button{border:0;font-size:12px;padding:8px 14px}.preview-tabs [aria-pressed=true]{background:#ffffff0c;color:var(--blue)}.stage{flex:1;display:flex;flex-direction:column;justify-content:center;align-items:center;padding:12px 0 30px}.event-poster{width:100%;max-width:620px;min-height:530px;background:radial-gradient(ellipse at 0 0,#203f70,transparent 70%),radial-gradient(ellipse at 100% 100%,#64243c,transparent 70%),#121623;display:flex;flex-direction:column;padding:30px;position:relative;box-shadow:0 20px 60px #0004}.event-poster::before{content:'';position:absolute;inset:12px;border:1px solid #ffffff24;pointer-events:none}.poster-top,.poster-bottom{display:flex;justify-content:space-between;gap:20px;font-size:10px;letter-spacing:.08em}.poster-top{color:#b9ccea}.poster-main{padding:55px 0;flex:1;display:flex;flex-direction:column;justify-content:center}.poster-date{font:700 27px 'Amatic SC',cursive;color:#9bbff6}.poster-main h2{font:700 clamp(40px,4.5vw,78px)/1.08 'Amatic SC',cursive;overflow-wrap:anywhere;margin:20px 0}.poster-main p{white-space:pre-wrap;font:400 24px/1.4 'Amatic SC',cursive;color:#d0d7e9;overflow-wrap:anywhere;margin:0;max-height:200px;overflow:auto}.poster-bottom{color:#efacb7;overflow-wrap:anywhere}.preview-caption{font-size:11px;line-height:1.7;color:var(--muted);max-width:50ch;text-align:center;margin:20px 0 0}.workspace-status{display:flex;justify-content:space-between;gap:12px;border-top:1px solid var(--line);padding-top:14px;font-size:10px;color:var(--muted)}#validation.invalid{color:var(--red)}#calendar-preview{margin:10px -12px 30px}fieldset{border:0;padding:0;margin:0;min-width:0}label{display:block;color:#bac4d8;font-size:11px;margin:17px 0 7px}label span{color:var(--red)}fieldset>label:first-child{margin-top:0}.two-fields{display:grid;grid-template-columns:1fr 1fr;gap:12px}.field-note{font-size:10px;line-height:1.6;color:var(--muted);margin:8px 0 0}textarea{resize:vertical}.edit-actions{display:flex;justify-content:space-between;margin-top:16px}.danger{color:var(--red);border-color:#ef7b8b33}.publish-help{margin-top:28px;border-top:1px solid var(--line);padding-top:18px;font-size:12px}.publish-help summary{cursor:pointer;color:var(--blue)}.publish-help ol{padding-left:18px;color:var(--muted);line-height:1.8}.publish-help li{margin-bottom:10px}.publish-help code{font-size:11px}.site-link{font-size:11px;display:block;margin-top:24px}.notice{position:fixed;bottom:24px;left:50%;transform:translateX(-50%);max-width:calc(100vw - 32px);padding:13px 22px;background:#25374f;color:white;border:1px solid var(--blue);border-radius:9px;z-index:20;box-shadow:0 10px 30px #0006}
@media(min-width:1600px){.workbench{grid-template-columns:270px minmax(320px,1fr) 370px}.event-poster{min-height:630px}.preview-area{padding:30px 60px}}
@media(max-width:1150px){.workbench{grid-template-columns:210px minmax(280px,1fr) 285px}.preview-area{padding:24px 18px}.event-poster{min-height:430px;padding:26px}.poster-top{font-size:8px}.poster-main{padding:30px 0}.topbar{padding:20px}.project-actions span{display:none}}
@media(max-width:900px){.workbench{grid-template-columns:220px 1fr}.inspector{grid-column:2;border-top:1px solid var(--line)}.library{grid-row:1/3}.preview-area{padding:24px}.event-poster{max-width:550px}.project-actions{flex-wrap:wrap;justify-content:flex-end}.topbar{gap:12px}.masthead{flex-shrink:0}.project-actions button{font-size:11px}.poster-main h2{font-size:58px}}
@media(max-width:600px){.topbar{flex-wrap:wrap;padding:16px}.masthead h1{font-size:36px}.project-actions{width:100%;margin:10px 0 0;justify-content:space-between;gap:5px}.project-actions button{padding:8px}.workbench{display:flex;flex-direction:column}.library{border-right:0;border-bottom:1px solid var(--line);padding:20px}.library-footer{padding-top:10px}.library-footer p{max-width:none;margin-bottom:0}.event-list{max-height:180px}.preview-area{padding:20px}.inspector{padding:24px 20px;border-left:0}.poster-main h2{font-size:50px}.event-poster{min-height:410px}.preview-toolbar>span{font-size:8px}.workspace-status{flex-direction:column}.preview-caption{font-size:10px}}

